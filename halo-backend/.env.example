# Copy to .env for local development. Heroku uses config vars instead.
MONGODB_URI=mongodb://localhost:27017/halo
PORT=3000
RATE_LIMIT_PER_MINUTE=120
# Shared app key: 16 letters/digits, identical to EXPO_PUBLIC_APP_KEY in halo-app/.env
APP_KEY=
# DeepSeek (AI meal analysis). Without a key the AI endpoints return 503.
DEEPSEEK_API_KEY=
