# Copy to .env (gitignored). EXPO_PUBLIC_* values are inlined into the bundle: restart Metro after changing them.
# Shared app key: 16 letters/digits, identical to APP_KEY in halo-backend/.env
EXPO_PUBLIC_APP_KEY=
# Backend URL; on a USB-connected phone use localhost with `adb reverse tcp:3000 tcp:3000`
EXPO_PUBLIC_API_URL=http://localhost:3000
