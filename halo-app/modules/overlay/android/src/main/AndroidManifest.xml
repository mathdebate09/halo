<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "Display over other apps": a special permission the user grants in Settings. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- A voice log from the ring: the service takes the microphone type only while it records. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Offline is told before recording, not after. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- Not a foreground service while it only draws the ring; microphone while a voice log records. -->
    <service
      android:name="expo.modules.overlay.OverlayService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <!-- Undo on a voice log's notification. -->
    <receiver
      android:name="expo.modules.overlay.VoiceUndoReceiver"
      android:exported="false" />
    <!-- Back after a reboot or an update, unless the user dragged it away. -->
    <receiver
      android:name="expo.modules.overlay.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
